<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Игнорируем ошибки версий, чтобы не душнило -->
    <NoWarn>$(NoWarn);NU1605</NoWarn> 
  </PropertyGroup>

  <ItemGroup>
    <!-- Маппер -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    
    <!-- Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    
    <!-- OpenAPI (Системный) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    
    <!-- Scalar -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.18" />
    
    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowMarket.Application\FlowMarket.Application.csproj" />
    <ProjectReference Include="..\FlowMarket.Infrastructure\FlowMarket.Infrastructure.csproj" />
  </ItemGroup>

</Project>